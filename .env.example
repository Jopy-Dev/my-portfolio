# Static site build configuration
SITE_URL=https://portfolio.example
SITE_BASE_PATH=
DEPLOY_ENV=development
NEXT_PUBLIC_CONTACT_ENDPOINT=https://contact.example/v1/contact
NEXT_PUBLIC_TURNSTILE_SITE_KEY=example-public-site-key
NEXT_PUBLIC_GTM_CONTAINER_ID=
NEXT_PUBLIC_POSTHOG_HOST=

# Contact Worker variables and secret-store placeholders
ENVIRONMENT=development
DELIVERY_MODE=fake
ALLOWED_ORIGINS=https://portfolio.example
ALLOWED_TURNSTILE_HOSTNAMES=portfolio.example
CONTACT_FROM_EMAIL=portfolio@example.com
TURNSTILE_SECRET_KEY=replace-in-worker-secret-store
CONTACT_TO_EMAIL=replace-in-worker-secret-store
ABUSE_KEY_SECRET=replace-with-at-least-32-random-bytes
CLOUDFLARE_API_TOKEN=replace-in-github-environment-secret-store
CLOUDFLARE_ACCOUNT_ID=replace-in-github-environment-variable

# Protected CI-only authenticity input
PRIVATE_CONTACT_DENYLIST=replace-in-github-production-environment-secret-store
